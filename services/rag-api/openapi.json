  "components": {
    "schemas": {
      "ChatCompletionRequest": {
        "properties": {
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model",
            "description": "Target model name (Ollama route)."
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "description": "Enable streaming responses.",
            "default": true
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "title": "Messages"
          }
        },
        "type": "object",
        "title": "ChatCompletionRequest",
        "description": "Expected body for POST /api/v1/chat/completions."
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage",
        "description": "Minimal chat message schema to mirror Open WebUI payloads."
      },
      "DeleteRequest": {
        "properties": {
          "collection_name": {
            "type": "string",
            "title": "Collection Name"
          },
          "file_id": {
            "type": "string",
            "title": "File Id"
          }
        },
        "type": "object",
        "required": [
          "collection_name",
          "file_id"
        ],
        "title": "DeleteRequest",
        "description": "Payload for removing a document from a collection."
      },
