# Copy this file to .env.local and adjust values for your environment

# Next.js base URLs
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="change-me"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://kb:kb@localhost:5432/kb"

# MongoDB (knowledge store)
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="kbapp"

# RAG service (FastAPI)
RAG_API_BASE="http://localhost:8000"
RAG_API_TOKEN="kb-dev-token"
RAG_SYNC_SERVICE_TOKEN="kb-dev-token"

# Feature toggles
USE_RAG_MOCK="false"
