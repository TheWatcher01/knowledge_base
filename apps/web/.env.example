# Copy this file to .env.local and fill in the variables for your environment.

# Runtime URLs & secrets
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="change-me"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Database connections
DATABASE_URL="postgresql://kb:kb@localhost:5432/kb"
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="kbapp"

# RAG service (FastAPI)
RAG_API_BASE="http://localhost:8000"
RAG_API_TOKEN=""
RAG_SYNC_SERVICE_TOKEN=""

# Feature toggles
USE_RAG_MOCK="false"
